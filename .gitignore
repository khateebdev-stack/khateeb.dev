# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
# whatsapp session
.wwebjs_auth
.wwebjs_cache
.wwebjs_auth/
.wwebjs_cache/

# logs
debug_output.txt
build_log.txt
*.log

# system
Thumbs.db
Desktop.ini
 
# Ignore all markdown files except README and Project Docs
*.md
!README.md
!readme.md
!SRS.md
!PROMPTS.md
!PROJECT_PROMPT.md
!MARKETING_KIT.md
!DEPLOYMENT_GUIDE.md
!CHATBOT_TECHNICAL_DOCS.md
!CHATBOT_INTEGRATION_GUIDE.md
!fiverr/*.md
!fiverr/*.md
!upwork/*.md
!fiverr/*.md
!upwork/*.md
!marketing/*.md
!public/projects/**/*.md
