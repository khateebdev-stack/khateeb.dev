                "required": true,
                "placeholder": "John Doe"
            },
            {
                "name": "email",
                "label": "Email Address",
                "required": true,
                "placeholder": "john@example.com"
            },
            {
                "name": "phone",
                "label": "Phone Number (Optional)",
                "required": false,
                "placeholder": "+1 234 567 8900"
            }
        ],
        "welcomeMessage": "Hi! Before we start, I'd love to know who I'm talking to. This helps us provide better assistance!",
        "thankYouMessage": "Thanks {name}! How can I help you today?"
    },
    "offlineMode": {
        "enabled": true,
        "message": "I'm currently offline, but my AI assistant can help you with common questions. For complex inquiries, please leave your details and I'll get back to you within 2-4 hours.",
        "suggestOptions": true,
        "createTicket": true
    }
